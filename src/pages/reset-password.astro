---
import Base from "../layouts/Base.astro";

const token = Astro.url.searchParams.get("token")?.trim() || "";
---

<Base title="ตั้งรหัสผ่านใหม่" description="กำหนดรหัสผ่านใหม่สำหรับบัญชีสมาชิกของคุณ">
	<section class="band section">
		<div class="frame">
			<div class="auth-card">
				<p class="eyebrow">กู้คืนบัญชีสมาชิก</p>
				<h1 class="auth-card__title">ตั้งรหัสผ่านใหม่</h1>

				{
					!token ? (
						<div>
							<p class="auth-card__desc" style="color: #ef4444; margin-top: 12px;">
								ไม่พบรหัสยืนยันการเปลี่ยนรหัสผ่าน ลิงก์อาจไม่สมบูรณ์หรือหมดอายุแล้ว
							</p>
							<p class="auth-switch" style="margin-top: 20px;">
								<a href="/forgot-password" class="btn">
									ขอลิงก์ตั้งรหัสผ่านใหม่
								</a>
							</p>
						</div>
					) : (
						<form id="reset-form" class="auth-form" data-token={token}>
							<div class="auth-field">
								<label for="new_password">รหัสผ่านใหม่ (อย่างน้อย 6 ตัวอักษร)</label>
								<input
									id="new_password"
									name="new_password"
									type="password"
									required
									minlength="6"
									placeholder="••••••••"
								/>
							</div>

							<div class="auth-field">
								<label for="confirm_password">ยืนยันรหัสผ่านใหม่อีกครั้ง</label>
								<input
									id="confirm_password"
									name="confirm_password"
									type="password"
									required
									minlength="6"
									placeholder="••••••••"
								/>
							</div>

							<p id="auth-error" class="auth-error" hidden />

							<button type="submit" id="submit-btn" class="btn auth-submit">
								บันทึกรหัสผ่านใหม่และเข้าสู่ระบบ
							</button>
						</form>
					)
				}
			</div>
		</div>
	</section>
</Base>

<script>
	const form = document.getElementById("reset-form") as HTMLFormElement | null;
	const errorEl = document.getElementById("auth-error");
	const submitBtn = document.getElementById("submit-btn") as HTMLButtonElement | null;

	form?.addEventListener("submit", async (e) => {
		e.preventDefault();
		if (!form || !errorEl || !submitBtn) return;

		errorEl.hidden = true;
		const formData = new FormData(form);
		const newPassword = String(formData.get("new_password") ?? "");
		const confirmPassword = String(formData.get("confirm_password") ?? "");

		if (newPassword !== confirmPassword) {
			errorEl.textContent = "รหัสผ่านใหม่ทั้งสองช่องไม่ตรงกัน";
			errorEl.hidden = false;
			return;
		}

		submitBtn.disabled = true;
		submitBtn.textContent = "กำลังบันทึก...";

		try {
			const res = await fetch("/api/member/reset-password", {
				method: "POST",
				headers: { "Content-Type": "application/json" },
				body: JSON.stringify({
					token: form.dataset.token,
					new_password: newPassword,
				}),
			});
			const data = await res.json();

			if (!res.ok) {
				errorEl.textContent = data.error || "ตั้งรหัสผ่านใหม่ไม่สำเร็จ";
				errorEl.hidden = false;
				submitBtn.disabled = false;
				submitBtn.textContent = "บันทึกรหัสผ่านใหม่และเข้าสู่ระบบ";
				return;
			}

			window.location.href = "/account";
		} catch {
			errorEl.textContent = "ไม่สามารถเชื่อมต่อเซิร์ฟเวอร์ได้ กรุณาลองใหม่";
			errorEl.hidden = false;
			submitBtn.disabled = false;
			submitBtn.textContent = "บันทึกรหัสผ่านใหม่และเข้าสู่ระบบ";
		}
	});
</script>

<style>
	.auth-card {
		width: 100%;
		max-width: 440px;
		min-width: 0;
		box-sizing: border-box;
		margin-inline: auto;
		padding: clamp(1.25rem, 4vw, 2.25rem);
		border: 1px solid var(--color-border);
		border-radius: 18px;
		background: var(--color-surface);
		box-shadow: var(--shadow-md);
	}

	.auth-card__title {
		margin-top: var(--spacing-2);
		font-size: var(--font-size-2xl);
		line-height: 1.3;
	}

	.auth-card__desc {
		margin-top: var(--spacing-2);
		font-size: var(--font-size-sm);
		color: var(--color-text-secondary);
	}

	.auth-form {
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		gap: var(--spacing-4);
		margin-top: var(--spacing-6);
	}

	.auth-field {
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		gap: 6px;
	}

	.auth-field label {
		font-size: var(--font-size-sm);
		font-weight: 500;
		color: var(--color-text);
	}

	.auth-field input {
		width: 100%;
		max-width: 100%;
		min-width: 0;
		box-sizing: border-box;
		height: 2.75rem;
		padding-inline: var(--spacing-4);
		border: 1px solid var(--color-border);
		border-radius: var(--radius);
		background: var(--color-bg);
		color: var(--color-text);
		font: inherit;
		font-size: var(--font-size-sm);
	}

	.auth-field input:focus {
		outline: 2px solid transparent;
		border-color: var(--color-brand);
		box-shadow: 0 0 0 3px var(--color-brand-ring);
	}

	.auth-error {
		padding: 10px 14px;
		border-radius: var(--radius);
		background: rgb(220 38 38 / 0.12);
		border: 1px solid rgb(220 38 38 / 0.35);
		color: #ef4444;
		font-size: var(--font-size-sm);
	}

	.auth-submit {
		width: 100%;
		min-height: 2.75rem;
		margin-top: var(--spacing-1);
	}

	.auth-submit:disabled {
		opacity: 0.65;
		cursor: not-allowed;
	}

	.auth-switch {
		margin-top: var(--spacing-5);
		text-align: center;
		font-size: var(--font-size-sm);
		color: var(--color-text-secondary);
	}
</style>