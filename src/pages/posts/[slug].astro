									<a href="/">หน้าแรก</a>
								</li>
							)
						}
						{
							!navItems.some((item) => item.url === "/posts") && (
								<li>
									<a href="/posts">บทความทั้งหมด</a>
								</li>
							)
						}
					</ul>
				</nav>

				<!-- 1. ช่องค้นหา -->
				<div class="mobile-menu__section">
					<p class="eyebrow mobile-menu__section-title">ค้นหา</p>
					<form method="get" action="/search" role="search" class="mobile-menu__search">
						<input
							type="search"
							name="q"
							placeholder="ค้นหาบทความ..."
							aria-label="ค้นหาบทความ"
							class="mobile-menu__search-input"
						/>
						<button type="submit" class="mobile-menu__search-btn">ค้นหา</button>
					</form>
				</div>

				<!-- 2. รายการโพสต์ล่าสุด -->
				{
					menuRecentPosts.length > 0 && (
						<div class="mobile-menu__section">
							<p class="eyebrow mobile-menu__section-title">โพสต์ล่าสุด</p>
							<ul class="mobile-menu__recent">
								{menuRecentPosts.map((item) => (
									<li>
										<a href={`/posts/${item.id}`} class="mobile-menu__recent-link">
											{item.data.featured_image && (
												<div class="mobile-menu__recent-thumb">
													<Image image={item.data.featured_image} sizes="40px" />
												</div>
											)}
											<div class="mobile-menu__recent-info">
												<span class="mobile-menu__recent-title">
													{item.data.title || "ไม่มีชื่อเรื่อง"}
												</span>
												{item.data.publishedAt && (
													<time
														datetime={item.data.publishedAt.toISOString()}
														class="mobile-menu__recent-date"
													>
														{formatDate(item.data.publishedAt, "long")}
													</time>
												)}
											</div>
										</a>
									</li>
								))}
							</ul>
						</div>
					)
				}

				<!-- 3. หมวดหมู่ -->
				{
					menuCategories.length > 0 && (
						<div class="mobile-menu__section">
							<p class="eyebrow mobile-menu__section-title">หมวดหมู่</p>
							<ul class="mobile-menu__list">
								{menuCategories.map((cat) => (
									<li>
										<a href={`/category/${cat.slug}`}>{cat.label}</a>
										{typeof (cat as any).count === "number" && (
											<span class="mobile-menu__count">({(cat as any).count})</span>
										)}
									</li>
								))}
							</ul>
						</div>
					)
				}

				<!-- 4. แท็ก -->
				{
					menuTags.length > 0 && (
						<div class="mobile-menu__section">
							<p class="eyebrow mobile-menu__section-title">แท็ก</p>
							<ul class="mobile-menu__tags">
								{menuTags.map((tag) => (
									<li>
										<a href={`/tag/${tag.slug}`} class="mobile-menu__tag-chip">
											{tag.label}
										</a>
									</li>
								))}
							</ul>
						</div>
					)
				}

				<!-- 5. คลังเก็บถาวร -->
				{
					menuArchives.length > 0 && (
						<div class="mobile-menu__section">
							<p class="eyebrow mobile-menu__section-title">คลังเก็บถาวร</p>
							<ul class="mobile-menu__list">
								{menuArchives.map((arc) => (
									<li>
										<a href="/posts">{arc.label}</a>
										<span class="mobile-menu__count">({arc.count})</span>
									</li>
								))}
							</ul>
						</div>
					)
				}
			</div>
		</aside>
	</div>
	{
		otherPostsWithTags.length > 0 && (
			<section class="band section" aria-labelledby="continue-reading">
				<div class="frame related">
					<div class="section-head">
						<h2 id="continue-reading" class="section-head__title">
							บทความอื่นๆ...
						</h2>
						<a href="/posts" class="arrow-link">
							บทความทั้งหมด
							<svg
								viewBox="0 0 24 24"
								fill="none"
								stroke="currentColor"
								stroke-width="1.75"
								stroke-linecap="round"
								stroke-linejoin="round"
								aria-hidden="true"
							>
								<path d="M5 12h14" />
								<path d="m12 5 7 7-7 7" />
							</svg>
						</a>
					</div>
					<div class="post-grid">
						{otherPostsWithTags.map(({ post: p, tags: postTags }) => (
							<PostCard
								post={p}
								tags={postTags}
								variant="card"
								headingLevel={3}
							/>
						))}
					</div>
				</div>
			</section>
		)
	}

	<script>
		import { initProtectedReader } from "../../lib/protected-reader";
		function initPostDrawers() {
			const content = document.querySelector("[data-post-content]");
			const toc = document.querySelector("[data-toc]");
			const list = document.querySelector("[data-toc-list]");
			const mobileToc = document.querySelector("[data-mobile-toc]");
			const mobileList = document.querySelector("[data-mobile-toc-list]");
			const tocToggleBtn = document.querySelector("[data-mobile-toc-toggle]");
			const tocCloseBtn = document.querySelector("[data-mobile-toc-close]");
			const tocBackdrop = document.querySelector("[data-mobile-toc-backdrop]");
			const tocDrawer = document.querySelector("[data-mobile-toc-drawer]");

			const mobileMenu = document.querySelector("[data-mobile-menu]");
			const menuToggleBtn = document.querySelector("[data-mobile-menu-toggle]");
			const menuCloseBtn = document.querySelector("[data-mobile-menu-close]");
			const menuBackdrop = document.querySelector("[data-mobile-menu-backdrop]");
			const menuDrawer = document.querySelector("[data-mobile-menu-drawer]");

			const setTocOpen = (open) => {
				if (!mobileToc || !tocToggleBtn || !tocDrawer) return;
				if (open) setMenuOpen(false);
				mobileToc.classList.toggle("is-open", open);
				tocToggleBtn.setAttribute("aria-expanded", String(open));
				tocDrawer.setAttribute("aria-hidden", String(!open));
				document.body.style.overflow = open ? "hidden" : "";
			};

			const setMenuOpen = (open) => {
				if (!mobileMenu || !menuToggleBtn || !menuDrawer) return;
				if (open) setTocOpen(false);
				mobileMenu.classList.toggle("is-open", open);
				menuToggleBtn.setAttribute("aria-expanded", String(open));
				menuDrawer.setAttribute("aria-hidden", String(!open));
				document.body.style.overflow = open ? "hidden" : "";
			};

			// ควบคุมปุ่มเมนูด้านขวา
			if (menuToggleBtn) {
				menuToggleBtn.onclick = () => {
					const isOpen = mobileMenu ? mobileMenu.classList.contains("is-open") : false;
					setMenuOpen(!isOpen);
				};
			}
			if (menuCloseBtn) menuCloseBtn.onclick = () => setMenuOpen(false);
			if (menuBackdrop) menuBackdrop.onclick = () => setMenuOpen(false);

			// แปลภาษาช่องค้นหาและวันที่ภายในแถบเมนูด้านขวา
			if (menuDrawer) {
				menuDrawer.querySelectorAll(".widget-search__input").forEach((input) => {
					if (input.placeholder === "Search...") input.placeholder = "ค้นหาบทความ...";
				});
				menuDrawer.querySelectorAll(".widget-search__button").forEach((btn) => {
					if (btn.textContent.trim() === "Search") btn.textContent = "ค้นหา";
				});
				menuDrawer.querySelectorAll(".widget-recent-posts__date").forEach((el) => {
					const raw = el.textContent.trim();
					if (/[A-Za-z]/.test(raw)) {
						const parsed = new Date(raw);
						if (!isNaN(parsed.getTime())) {
							el.textContent = parsed.toLocaleDateString("th-TH", {
								year: "numeric",
								month: "long",
								day: "numeric",
							});
						}
					}
				});
				menuDrawer.querySelectorAll(".widget-archives a").forEach((el) => {
					const raw = el.textContent.trim();
					if (/^[A-Za-z]+\s+\d{4}$/.test(raw)) {
						const parsed = new Date(`1 ${raw}`);
						if (!isNaN(parsed.getTime())) {
							el.textContent = parsed.toLocaleDateString("th-TH", {
								year: "numeric",
								month: "long",
							});
						}
					}
				});
			}

			// กด Esc เพื่อปิดแถบที่เปิดอยู่
			document.onkeydown = (e) => {
				if (e.key === "Escape") {
					if (mobileToc && mobileToc.classList.contains("is-open")) setTocOpen(false);
					if (mobileMenu && mobileMenu.classList.contains("is-open")) setMenuOpen(false);
				}
			};

			// สร้างสารบัญ (TOC) ครบทุกบท พร้อมระบุสถานะหัวข้อที่ล็อกอยู่
			if (!toc || !list) return;

			let fullToc = [];
			try {
				fullToc = JSON.parse(toc.dataset.fullToc || "[]");
			} catch {
				fullToc = [];
			}

			const renderedHeadings = content ? [...content.querySelectorAll("h2, h3")] : [];
			const isEmpty = fullToc.length === 0 && renderedHeadings.length === 0;
			toc.hidden = isEmpty;
			if (mobileToc) mobileToc.hidden = isEmpty;
			if (isEmpty) return;

			if (tocToggleBtn) {
				tocToggleBtn.onclick = () => {
					const isOpen = mobileToc ? mobileToc.classList.contains("is-open") : false;
					setTocOpen(!isOpen);
				};
			}
			if (tocCloseBtn) tocCloseBtn.onclick = () => setTocOpen(false);
			if (tocBackdrop) tocBackdrop.onclick = () => setTocOpen(false);

			list.innerHTML = "";
			if (mobileList) mobileList.innerHTML = "";

			const tocItems =
				fullToc.length > 0
					? fullToc
					: renderedHeadings.map((h) => ({
							level: h.tagName.toLowerCase(),
							text: h.textContent || "",
						}));

			const links = new Map();
			tocItems.forEach((itemData, index) => {
				const targetHeading = renderedHeadings[index];
				const isLocked = !targetHeading;

				if (targetHeading && !targetHeading.id) {
					targetHeading.id = `heading-${index}`;
				}

				const createItem = (closeOnClick) => {
					const item = document.createElement("li");
					item.className =
						itemData.level === "h3"
							? "toc__item toc__item--nested"
							: "toc__item";

					const link = document.createElement("a");
					link.href = isLocked ? "#paywall-box" : `#${targetHeading.id}`;
					link.className = isLocked ? "toc__link toc__link--locked" : "toc__link";

					const textSpan = document.createElement("span");
					textSpan.textContent = itemData.text;
					link.appendChild(textSpan);

					if (isLocked) {
						link.title = "เนื้อหาสำหรับสมาชิก / ผู้สั่งซื้อ";
						const lockIcon = document.createElement("span");
						lockIcon.className = "toc__lock-icon";
						lockIcon.setAttribute("aria-label", "ล็อกอยู่");
						lockIcon.innerHTML = `<svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>`;
						link.appendChild(lockIcon);
					}

					if (closeOnClick) {
						link.addEventListener("click", () => setTocOpen(false));
					}

					item.appendChild(link);
					return { item, link };
				};

				const desktop = createItem(false);
				list.appendChild(desktop.item);
				const group = [desktop.link];

				if (mobileList) {
					const mobile = createItem(true);
					mobileList.appendChild(mobile.item);
					group.push(mobile.link);
				}

				if (targetHeading) {
					links.set(targetHeading, group);
				}
			});

			const setCurrent = (activeGroup) => {
				for (const group of links.values()) {
					for (const link of group) {
						link.removeAttribute("aria-current");
					}
				}
				for (const link of activeGroup) {
					link.setAttribute("aria-current", "true");
				}
			};
			const first = links.values().next().value;
			if (first) setCurrent(first);

			if (renderedHeadings.length > 0) {
				const observer = new IntersectionObserver(
					(entries) => {
						for (const entry of entries) {
							const group = links.get(entry.target);
							if (group && entry.isIntersecting) setCurrent(group);
						}
					},
					{ rootMargin: "-80px 0px -80% 0px" },
				);

				renderedHeadings.forEach((heading) => observer.observe(heading));
			}
		}

		initPostDrawers();
		initProtectedReader();
		// ระบบปรับขนาดตัวอักษรและจดจำค่าที่ผู้ใช้เลือก
		function initFontSizeControl() {
			const contentEl = document.querySelector("[data-post-content]");
			const decBtn = document.querySelector("[data-font-decrease]");
			const incBtn = document.querySelector("[data-font-increase]");
			const resetBtn = document.querySelector("[data-font-reset]");
			if (!(contentEl instanceof HTMLElement) || !decBtn || !incBtn || !resetBtn) return;

			const scales = [0.9, 1, 1.12, 1.25, 1.38];
			const labels = ["90%", "100%", "112%", "125%", "138%"];
			const storageKey = "reader-font-scale-idx";

			let currentIndex = 1;
			try {
				const saved = localStorage.getItem(storageKey);
				if (saved !== null) {
					const parsed = Number(saved);
					if (!isNaN(parsed) && parsed >= 0 && parsed < scales.length) {
						currentIndex = parsed;
					}
				}
			} catch {}

			const applyScale = (idx) => {
				currentIndex = Math.max(0, Math.min(scales.length - 1, idx));
				contentEl.style.setProperty("--reader-scale", String(scales[currentIndex]));
				resetBtn.textContent = labels[currentIndex];
				if (decBtn instanceof HTMLButtonElement) decBtn.disabled = currentIndex === 0;
				if (incBtn instanceof HTMLButtonElement) incBtn.disabled = currentIndex === scales.length - 1;
				try {
					localStorage.setItem(storageKey, String(currentIndex));
				} catch {}
			};

			applyScale(currentIndex);

			decBtn.addEventListener("click", () => applyScale(currentIndex - 1));
			incBtn.addEventListener("click", () => applyScale(currentIndex + 1));
			resetBtn.addEventListener("click", () => applyScale(1));
		}

		initFontSizeControl();
		// ระบบบันทึกตำแหน่งที่อ่านค้างไว้แยกตามหนังสือ/บทความ
		function initReadingProgress() {
			const banner = document.getElementById("reading-resume-banner");
			const contentEl = document.querySelector("[data-post-content]");
			if (!(banner instanceof HTMLElement) || !(contentEl instanceof HTMLElement)) return;

			const bookSlug = banner.dataset.bookSlug || "";
			const chapterSlug = banner.dataset.chapterSlug || "";
			const chapterTitle = banner.dataset.chapterTitle || "";
			if (!chapterSlug) return;

			const storageKey = `ebook-progress:${bookSlug || chapterSlug}`;
			const textEl = banner.querySelector("[data-resume-text]");
			const jumpBtn = banner.querySelector("[data-resume-jump]");
			const dismissBtn = banner.querySelector("[data-resume-dismiss]");

			// ตรวจสอบประวัติที่อ่านค้างไว้ในบทปัจจุบัน
			try {
				const raw = localStorage.getItem(storageKey);
				if (raw) {
					const saved = JSON.parse(raw);
					if (
						saved &&
						saved.chapterSlug === chapterSlug &&
						typeof saved.percent === "number" &&
						saved.percent >= 8 &&
						saved.percent <= 95
					) {
						if (textEl) {
							textEl.textContent = `คุณอ่านบทนี้ค้างไว้ประมาณ ${saved.percent}%`;
						}
						banner.hidden = false;

						jumpBtn?.addEventListener("click", () => {
							const rect = contentEl.getBoundingClientRect();
							const docTop = window.scrollY + rect.top;
							const targetY = docTop + contentEl.offsetHeight * (saved.percent / 100) - 100;
							window.scrollTo({ top: Math.max(0, targetY), behavior: "smooth" });
							banner.hidden = true;
						});
					}
				}
			} catch {}

			dismissBtn?.addEventListener("click", () => {
				banner.hidden = true;
			});

			// บันทึกความคืบหน้าอัตโนมัติระหว่างเลื่อนอ่าน
			let saveTimer = null;
			const saveCurrentProgress = () => {
				const rect = contentEl.getBoundingClientRect();
				const totalHeight = contentEl.offsetHeight;
				if (totalHeight <= 0) return;

				const viewportAnchor = window.innerHeight * 0.45;
				const scrolledPx = viewportAnchor - rect.top;
				const percent = Math.max(0, Math.min(100, Math.round((scrolledPx / totalHeight) * 100)));

				if (percent < 5) return;

				try {
					localStorage.setItem(
						storageKey,
						JSON.stringify({
							chapterSlug,
							chapterTitle,
							percent,
							updatedAt: Date.now(),
						}),
					);
				} catch {}
			};

			window.addEventListener(
				"scroll",
				() => {
					if (saveTimer) clearTimeout(saveTimer);
					saveTimer = setTimeout(saveCurrentProgress, 250);
				},
				{ passive: true },
			);
		}

		initReadingProgress();
		// ฟังก์ชันเริ่มสร้างหน้าชำระเงิน Stripe
		async function startStripeCheckout(mode, targetSlug, triggerBtn) {
			const originalText = triggerBtn ? triggerBtn.textContent : "";
			if (triggerBtn) {
				triggerBtn.disabled = true;
				triggerBtn.textContent = "กำลังเชื่อมต่อหน้าชำระเงิน...";
			}

			try {
				const res = await fetch("/api/stripe/checkout", {
					method: "POST",
					headers: { "Content-Type": "application/json" },
					body: JSON.stringify({
						mode,
						target_slug: targetSlug,
						return_path: window.location.pathname,
					}),
				});
				const data = await res.json();
				if (!res.ok || !data.url) {
					alert(data.error || "ไม่สามารถเปิดหน้าชำระเงินได้");
					if (triggerBtn) {
						triggerBtn.disabled = false;
						triggerBtn.textContent = originalText;
					}
					return;
				}
				window.location.href = data.url;
			} catch {
				alert("เกิดข้อผิดพลาดในการเชื่อมต่อเซิร์ฟเวอร์");
				if (triggerBtn) {
					triggerBtn.disabled = false;
					triggerBtn.textContent = originalText;
				}
			}
		}

		// เชื่อมต่อปุ่มสั่งซื้อเมื่อผู้ใช้กดเอง
		document.querySelectorAll("[data-checkout-btn]").forEach((btn) => {
			if (!(btn instanceof HTMLButtonElement)) return;
			btn.addEventListener("click", () => {
				startStripeCheckout(btn.dataset.checkoutMode || "onetime", btn.dataset.targetSlug || "", btn);
			});
		});

		// ตรวจสอบการส่งต่อเข้าหน้าชำระเงินอัตโนมัติหลังสมัครสมาชิกหรือเข้าสู่ระบบ
		(function handleAutoCheckout() {
			const url = new URL(window.location.href);
			const hasAutoParam = url.searchParams.has("auto_checkout");
			const paywallEl = document.getElementById("paywall-box");
			const autoMode = paywallEl?.dataset.autoCheckout || "";
			const autoTarget = paywallEl?.dataset.autoTarget || "";

			// ล้างพารามิเตอร์ออกจากแถบ URL ทันทีเพื่อไม่ให้วนลูปเมื่อกดย้อนกลับหรือรีเฟรช
			if (hasAutoParam) {
				url.searchParams.delete("auto_checkout");
				url.searchParams.delete("target_slug");
				const cleanSearch = url.searchParams.toString();
				window.history.replaceState({}, "", `${url.pathname}${cleanSearch ? `?${cleanSearch}` : ""}${url.hash}`);
			}

			// หากเพิ่งล็อกอิน/สมัครสมาชิกสำเร็จและยังไม่มีสิทธิ์ ให้พาไปหน้า Stripe ทันที
			if (autoMode && paywallEl) {
				paywallEl.scrollIntoView({ behavior: "smooth", block: "center" });
				const matchingBtn = paywallEl.querySelector(`[data-checkout-mode="${autoMode}"]`);
				startStripeCheckout(
					autoMode,
					autoTarget,
					matchingBtn instanceof HTMLButtonElement ? matchingBtn : null,
				);
			}
		})();
	</script>
</Base>

