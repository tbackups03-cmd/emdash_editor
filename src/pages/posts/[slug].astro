	<!-- ปุ่มเปิดเมนู (ขวาล่าง) และแถบเมนูด้านขวาสำหรับมือถือ -->
	<div class="mobile-menu" data-mobile-menu>
		<button
			type="button"
			class="mobile-menu__toggle"
			aria-label="เปิดเมนู"
			aria-expanded="false"
			aria-controls="mobile-menu-drawer"
			data-mobile-menu-toggle
