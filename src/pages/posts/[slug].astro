				<h2 id="mobile-menu-title" class="eyebrow">เมนูและเครื่องมือ</h2>
				<button
					type="button"
					class="mobile-menu__close"
					aria-label="ปิดเมนู"
					data-mobile-menu-close
				>
					<svg
						viewBox="0 0 24 24"
						fill="none"
						stroke="currentColor"
						stroke-width="2"
						stroke-linecap="round"
						stroke-linejoin="round"
						aria-hidden="true"
					>
						<path d="M18 6 6 18"></path>
						<path d="m6 6 12 12"></path>
					</svg>
				</button>
			</div>

			<div class="mobile-menu__body">
				<!-- เมนูนำทางหลัก -->
				<nav class="mobile-menu__section" aria-label="เมนูหลัก">
					<p class="eyebrow mobile-menu__section-title">นำทาง</p>
					<ul class="mobile-menu__links">
