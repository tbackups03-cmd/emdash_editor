		align-items: baseline;
		justify-content: space-between;
		gap: var(--spacing-3);
		padding-block: 3px;
	}

	.post-widgets
		:global(:is(.widget-categories__count, .widget-archives__count)),
	.post-widgets :global(.widget-tags__count) {
		font-family: var(--font-mono);
		font-size: var(--font-size-label);
		color: var(--color-muted);
		font-variant-numeric: tabular-nums;
	}

	.post-widgets :global(:is(.widget-categories__empty, .widget-tags__empty)) {
		color: var(--color-muted);
	}

	.post-widgets :global(.widget-tags__cloud) {
		display: flex;
		flex-wrap: wrap;
		gap: 6px;
	}

	.post-widgets :global(.widget-tags__cloud li) {
		display: inline-flex;
		align-items: center;
		gap: var(--spacing-1);
	}

	.post-widgets :global(.widget-tags__link) {
		display: inline-flex;
		align-items: center;
		min-height: 26px;
		padding: 2px 10px;
		border-radius: var(--radius-full);
		background: var(--color-surface);
		box-shadow: inset 0 0 0 1px var(--color-border);
		font-size: var(--font-size-xs);
		font-weight: 500;
		line-height: 1.3;
		color: var(--color-text-secondary);
		text-decoration: none;
		transition:
			color var(--transition-fast),
			box-shadow var(--transition-fast);
	}

	.post-widgets :global(.widget-tags__link:hover) {
		color: var(--color-text);
		box-shadow: inset 0 0 0 1px var(--color-border-strong);
	}

	.post-widgets :global(.widget-recent-posts) {
		display: grid;
		gap: var(--spacing-4);
	}

	.post-widgets :global(.widget-recent-posts li) {
		display: grid;
		gap: 2px;
	}

	.post-widgets
		:global(.widget-recent-posts li:has(> .widget-recent-posts__thumbnail)) {
		grid-template-columns: 40px minmax(0, 1fr);
		align-items: center;
		column-gap: var(--spacing-3);
	}

	.post-widgets :global(.widget-recent-posts__thumbnail) {
		grid-row: span 2;
		width: 40px;
		height: 40px;
		border-radius: var(--radius-sm);
		object-fit: cover;
		outline: 1px solid var(--color-media-outline);
		outline-offset: -1px;
	}

	.post-widgets :global(.widget-recent-posts__link) {
		font-weight: 500;
		line-height: var(--leading-snug);
		color: var(--color-text);
		text-decoration-line: underline;
		text-decoration-color: transparent;
	}

	.post-widgets :global(.widget-recent-posts__link:hover) {
		text-decoration-color: currentColor;
	}

	.post-widgets :global(.widget-recent-posts__date) {
		font-size: var(--font-size-xs);
		color: var(--color-muted);
		font-variant-numeric: tabular-nums;
	}

	/* Continue reading */
	.related {
		container-type: inline-size;
	}

	.related .post-grid {
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr));
	}

	/* At two columns the third card would sit alone on its own row */
	@container (min-width: 31.5rem) and (max-width: 47.99rem) {
		.related .post-grid > :global(:nth-child(3)) {
			display: none;
		}
	}

	@media (min-width: 1100px) {
		.post-widgets {
			padding-block-start: 0;
			border-block-start: 0;
		}

		.post-widgets :global(.widget-area) {
			columns: auto;
		}

		.post-widgets :global(.widget) {
			margin-block-end: var(--spacing-8);
		}
	}

	@media (max-width: 720px) {
		.post-header__lead {
			font-size: var(--font-size-lg);
		}

		.post-hero__media {
			aspect-ratio: 16 / 9;
			border-radius: var(--radius-lg);
		}

		.post-widgets :global(.widget-search__input) {
			font-size: var(--font-size-base);
		}
	}
	/* สารบัญแบบกดเปิด/ปิดด้านซ้ายสำหรับหน้าจอมือถือและแท็บเล็ต */
	.mobile-toc__toggle {
		position: fixed;
		bottom: var(--spacing-4);
		inset-inline-start: var(--spacing-3);
		z-index: 90;
		display: inline-flex;
		align-items: center;
		gap: 0.375rem;
		height: 2.25rem;
		padding-inline: var(--spacing-3);
		border: 1px solid var(--color-border-strong);
		border-radius: var(--radius-full);
		background: var(--color-brand);
		color: var(--color-on-brand);
		font: inherit;
		font-size: var(--font-size-xs);
		font-weight: 500;
		box-shadow: var(--shadow-lg);
		cursor: pointer;
		transition:
			background-color var(--transition-fast),
			transform var(--transition-fast);
	}

	.mobile-toc__toggle:hover {
		background: var(--color-brand-hover);
	}

	.mobile-toc__toggle:active {
		transform: scale(0.96);
	}

	.mobile-toc__toggle svg {
		width: 15px;
		height: 15px;
	}

	.mobile-toc__backdrop {
		position: fixed;
		inset: 0;
		z-index: 100;
		background: rgb(0 0 0 / 0.5);
		opacity: 0;
		visibility: hidden;
		transition:
			opacity var(--transition-base),
			visibility var(--transition-base);
	}

	.mobile-toc.is-open .mobile-toc__backdrop {
		opacity: 1;
		visibility: visible;
	}

	.mobile-toc__drawer {
		position: fixed;
		top: 0;
		bottom: 0;
		left: 0;
		z-index: 110;
		display: flex;
		flex-direction: column;
		width: min(82vw, 320px);
		padding: var(--spacing-5);
		border-right: 1px solid var(--color-border);
		background: var(--color-surface);
		box-shadow: var(--shadow-lg);
		transform: translateX(-100%);
		visibility: hidden;
		transition:
			transform var(--transition-base),
			visibility var(--transition-base);
	}

	.mobile-toc.is-open .mobile-toc__drawer {
		transform: translateX(0);
		visibility: visible;
	}

	.mobile-toc__header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: var(--spacing-3);
		padding-block-end: var(--spacing-4);
		margin-block-end: var(--spacing-4);
		border-block-end: 1px solid var(--color-border);
	}

	.mobile-toc__close {
		display: grid;
		place-items: center;
		width: 2rem;
		height: 2rem;
		padding: 0;
		border: 1px solid var(--color-border);
		border-radius: var(--radius-full);
		background: var(--color-bg);
		color: var(--color-text-secondary);
		cursor: pointer;
	}

	.mobile-toc__close:hover {
		color: var(--color-text);
		border-color: var(--color-border-strong);
	}

	.mobile-toc__close svg {
		width: 16px;
		height: 16px;
	}

	.mobile-toc__nav {
		flex: 1;
		overflow-y: auto;
	}

	.mobile-toc__list :global(.toc__link) {
		display: block;
		margin-inline-start: -1px;
		padding-block: 7px;
		padding-inline: var(--spacing-3) 0;
		border-inline-start: 2px solid transparent;
		color: var(--color-text-secondary);
		font-size: var(--font-size-sm);
		line-height: var(--leading-snug);
		text-decoration: none;
	}

	.mobile-toc__list :global(.toc__item--nested .toc__link) {
		padding-inline-start: var(--spacing-6);
	}

	.mobile-toc__list :global(.toc__link[aria-current="true"]) {
		border-inline-start-color: var(--color-brand);
		color: var(--color-brand);
		font-weight: 600;
	}

	@media (min-width: 1100px) {
		.mobile-toc {
			display: none !important;
		}
	}
	/* โทนสีเฉพาะของโซนเมนู (ชมพูกลีบบัวอมม่วง แตกต่างจากสีม่วงหลัก และไม่เข้มทึบ) */
	.mobile-menu {
		--menu-accent: #8c4a78;
		--menu-accent-hover: #763c64;
		--menu-on-accent: #ffffff;
		--menu-drawer-bg: #faf4f8;
		--menu-drawer-surface: #f2e6ee;
		--menu-drawer-border: #e3cddc;
	}

	:global(:root.dark) .mobile-menu {
		--menu-accent: #d896c0;
		--menu-accent-hover: #e3add0;
		--menu-on-accent: #21121c;
		--menu-drawer-bg: #261b24;
		--menu-drawer-surface: #332430;
		--menu-drawer-border: #473343;
	}

	/* ปุ่มเมนูมุมขวาล่าง ขนาดเท่ากับปุ่มสารบัญเป๊ะ */
	.mobile-menu__toggle {
		position: fixed;
		bottom: var(--spacing-4);
		inset-inline-end: var(--spacing-3);
		z-index: 90;
		display: inline-flex;
		align-items: center;
		gap: 0.375rem;
		height: 2.25rem;
		padding-inline: var(--spacing-3);
		border: 1px solid var(--menu-drawer-border);
		border-radius: var(--radius-full);
		background: var(--menu-accent);
		color: var(--menu-on-accent);
		font: inherit;
		font-size: var(--font-size-xs);
		font-weight: 500;
		box-shadow: var(--shadow-lg);
		cursor: pointer;
		transition:
			background-color var(--transition-fast),
			transform var(--transition-fast);
	}

	.mobile-menu__toggle:hover {
		background: var(--menu-accent-hover);
	}

	.mobile-menu__toggle:active {
		transform: scale(0.96);
	}

	.mobile-menu__toggle svg {
		width: 15px;
		height: 15px;
	}

	.mobile-menu__backdrop {
		position: fixed;
		inset: 0;
		z-index: 100;
		background: rgb(0 0 0 / 0.45);
		opacity: 0;
		visibility: hidden;
		transition:
			opacity var(--transition-base),
			visibility var(--transition-base);
	}

	.mobile-menu.is-open .mobile-menu__backdrop {
		opacity: 1;
		visibility: visible;
	}

	/* แถบเมนูเลื่อนจากด้านขวามือ */
	.mobile-menu__drawer {
		position: fixed;
		top: 0;
		bottom: 0;
		right: 0;
		z-index: 110;
		display: flex;
		flex-direction: column;
		width: min(85vw, 340px);
		padding: var(--spacing-5);
		border-left: 1px solid var(--menu-drawer-border);
		background: var(--menu-drawer-bg);
		box-shadow: var(--shadow-lg);
		transform: translateX(100%);
		visibility: hidden;
		transition:
			transform var(--transition-base),
			visibility var(--transition-base);
	}

	.mobile-menu.is-open .mobile-menu__drawer {
		transform: translateX(0);
		visibility: visible;
	}

	.mobile-menu__header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: var(--spacing-3);
		padding-block-end: var(--spacing-4);
		margin-block-end: var(--spacing-4);
		border-block-end: 1px solid var(--menu-drawer-border);
	}

	.mobile-menu__header .eyebrow {
		color: var(--menu-accent);
	}

	.mobile-menu__close {
		display: grid;
		place-items: center;
		width: 2rem;
		height: 2rem;
		padding: 0;
		border: 1px solid var(--menu-drawer-border);
		border-radius: var(--radius-full);
		background: var(--menu-drawer-surface);
		color: var(--color-text-secondary);
		cursor: pointer;
	}

	.mobile-menu__close:hover {
		color: var(--color-text);
	}

	.mobile-menu__close svg {
		width: 16px;
		height: 16px;
	}

	.mobile-menu__body {
		flex: 1;
		overflow-y: auto;
		display: grid;
		align-content: start;
		gap: var(--spacing-6);
		padding-inline-end: 2px;
	}

	.mobile-menu__section-title {
		margin-block-end: var(--spacing-2);
		color: var(--menu-accent);
	}

	.mobile-menu__links {
		display: grid;
		gap: 4px;
		list-style: none;
		padding: 0;
	}

	.mobile-menu__links a {
		display: block;
		padding: 8px 12px;
		border-radius: var(--radius);
		background: var(--menu-drawer-surface);
		color: var(--color-text);
		font-size: var(--font-size-sm);
		font-weight: 500;
		text-decoration: none;
		transition: background-color var(--transition-fast);
	}

	.mobile-menu__links a:hover {
		background: var(--menu-drawer-border);
	}

	/* ตกแต่งทั้ง 5 ส่วนภายในโซนเมนู */
	.mobile-menu__search {
		position: relative;
	}

	.mobile-menu__search-input {
		width: 100%;
		height: 36px;
		padding-block: 0;
		padding-inline: var(--spacing-4) 4.5rem;
		border: 1px solid var(--menu-drawer-border);
		border-radius: var(--radius-full);
		background: var(--menu-drawer-surface);
		color: var(--color-text);
		font: inherit;
		font-size: var(--font-size-sm);
	}

	.mobile-menu__search-input::placeholder {
		color: var(--color-muted);
	}

	.mobile-menu__search-btn {
		position: absolute;
		top: 4px;
		inset-inline-end: 4px;
		height: 28px;
		padding-inline: var(--spacing-3);
		border: 0;
		border-radius: var(--radius-full);
		background: var(--menu-accent);
		color: var(--menu-on-accent);
		font: inherit;
		font-size: var(--font-size-xs);
		font-weight: 500;
		cursor: pointer;
	}

	.mobile-menu__recent {
		display: grid;
		gap: var(--spacing-3);
		list-style: none;
		padding: 0;
	}

	.mobile-menu__recent-link {
		display: flex;
		align-items: center;
		gap: var(--spacing-3);
		text-decoration: none;
	}

	.mobile-menu__recent-thumb {
		flex-shrink: 0;
		width: 40px;
		height: 40px;
		border-radius: var(--radius-sm);
		overflow: hidden;
		background: var(--menu-drawer-surface);
	}

	.mobile-menu__recent-thumb :global(img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.mobile-menu__recent-info {
		display: grid;
		gap: 2px;
		min-width: 0;
	}

	.mobile-menu__recent-title {
		font-size: var(--font-size-sm);
		font-weight: 500;
		line-height: var(--leading-snug);
		color: var(--color-text);
	}

	.mobile-menu__recent-link:hover .mobile-menu__recent-title {
		color: var(--menu-accent);
	}

	.mobile-menu__recent-date {
		font-size: var(--font-size-xs);
		color: var(--color-muted);
	}

	.mobile-menu__list {
		display: grid;
		gap: 4px;
		list-style: none;
		padding: 0;
	}

	.mobile-menu__list li {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: var(--spacing-3);
		padding-block: 3px;
	}

	.mobile-menu__list a {
		font-size: var(--font-size-sm);
		color: var(--color-text-secondary);
		text-decoration: none;
	}

	.mobile-menu__list a:hover {
		color: var(--menu-accent);
	}

	.mobile-menu__count {
		font-family: var(--font-mono);
		font-size: var(--font-size-label);
		color: var(--color-muted);
	}

	.mobile-menu__tags {
		display: flex;
		flex-wrap: wrap;
		gap: 6px;
		list-style: none;
		padding: 0;
	}

	.mobile-menu__tag-chip {
		display: inline-flex;
		align-items: center;
		min-height: 26px;
		padding: 2px 10px;
		border-radius: var(--radius-full);
		background: var(--menu-drawer-surface);
		box-shadow: inset 0 0 0 1px var(--menu-drawer-border);
		font-size: var(--font-size-xs);
		font-weight: 500;
		color: var(--color-text-secondary);
		text-decoration: none;
	}

	.mobile-menu__tag-chip:hover {
		color: var(--menu-accent);
		box-shadow: inset 0 0 0 1px var(--menu-accent);
	}

	@media (min-width: 1100px) {
		.mobile-menu {
			display: none !important;
		}
	}
	/* เอฟเฟกต์จางท้ายตัวอย่างบทความและกล่องแจ้งเตือนสิทธิ์ (Paywall) */
	.prose--locked-preview {
		position: relative;
	}

	.prose--locked-preview::after {
		content: "";
		position: absolute;
		inset-inline: 0;
		bottom: 0;
		height: 5.5rem;
		background: linear-gradient(to bottom, transparent, var(--color-bg));
		pointer-events: none;
	}

	.paywall-box {
		margin-block-start: var(--spacing-6);
		padding: clamp(1.5rem, 4vw, 2.25rem);
		border: 1px solid var(--color-border-strong);
		border-radius: 20px;
		background: var(--color-surface);
		box-shadow: var(--shadow-lg);
		text-align: center;
	}

	.paywall-box__badge {
		display: inline-block;
		padding: 4px 12px;
		border-radius: var(--radius-full);
		background: var(--color-fill-strong);
		color: var(--color-brand);
		font-size: var(--font-size-xs);
		font-weight: 600;
	}

	.paywall-box__title {
		margin-top: var(--spacing-3);
		font-size: var(--font-size-xl);
		line-height: 1.35;
	}

	.paywall-box__desc {
		max-width: 52ch;
		margin-inline: auto;
		margin-top: var(--spacing-2);
		font-size: var(--font-size-sm);
		color: var(--color-text-secondary);
	}

	.paywall-plans {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr));
		gap: var(--spacing-4);
		margin-top: var(--spacing-6);
		text-align: left;
	}

	.paywall-plan {
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		gap: var(--spacing-4);
		padding: var(--spacing-5);
		border: 1px solid var(--color-border);
		border-radius: 16px;
		background: var(--color-bg);
	}

	.paywall-plan--vip {
		border-color: var(--color-brand);
		box-shadow: inset 0 0 0 1px var(--color-brand-ring);
	}

	.paywall-plan__tag {
		font-family: var(--font-mono);
		font-size: 11px;
		font-weight: 600;
		color: var(--color-brand);
	}

	.paywall-plan__name {
		margin-top: 4px;
		font-size: var(--font-size-base);
	}

	.paywall-plan__price {
		margin-top: 6px;
		font-size: var(--font-size-lg);
		font-weight: 700;
		color: var(--color-text);
	}

	.paywall-plan__price span {
		font-size: var(--font-size-xs);
		font-weight: 400;
		color: var(--color-muted);
	}

	.paywall-plan__features {
		display: grid;
		gap: 6px;
		padding-inline-start: 1.1rem;
		font-size: var(--font-size-xs);
		color: var(--color-text-secondary);
	}

	.paywall-plan__btn {
		width: 100%;
		margin-top: auto;
	}

	.paywall-box__footer {
		margin-top: var(--spacing-5);
		font-size: var(--font-size-sm);
		color: var(--color-text-secondary);
	}
	/* สไตล์หัวข้อในสารบัญส่วนที่ล็อกอยู่สำหรับสมาชิก */
	.toc :global(.toc__link--locked),
	.mobile-toc__list :global(.toc__link--locked) {
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
		gap: 6px;
		opacity: 0.78;
	}

	.toc :global(.toc__lock-icon),
	.mobile-toc__list :global(.toc__lock-icon) {
		flex-shrink: 0;
		margin-top: 3px;
		color: var(--color-muted);
	}
	/* ระบบป้องกันการคัดลอกข้อความและการสั่งพิมพ์ (เบาเครื่อง โหลดเร็ว) */
	.post-main--protected {
		user-select: none;
		-webkit-user-select: none;
		-webkit-touch-callout: none;
	}

	.post-main--protected :is(input, textarea) {
		user-select: text;
		-webkit-user-select: text;
	}

	.print-block-notice {
		display: none;
	}

	@media print {
		.post-main--protected .protected-reading-wrap {
			display: none !important;
		}

		.post-main--protected .print-block-notice {
			display: block !important;
			padding: 2rem;
			border: 1px solid #ccc;
			text-align: center;
			font-size: 1rem;
		}
	}
	/* แถบปรับขนาดตัวอักษรแบบลอยติดหน้าจอ (ไม่ทับปุ่มสารบัญซ้ายและปุ่มเมนูขวา) */
	.reader-toolbar {
		position: fixed;
		bottom: var(--spacing-4);
		left: 50%;
		transform: translateX(-50%);
		z-index: 85;
		display: inline-flex;
		align-items: center;
		gap: 2px;
		height: 2.25rem;
