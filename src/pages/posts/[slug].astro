				<button
					type="button"
					class="mobile-toc__close"
					aria-label="ปิดสารบัญ"
					data-mobile-toc-close
				>
					<svg
						viewBox="0 0 24 24"
						fill="none"
						stroke="currentColor"
						stroke-width="2"
						stroke-linecap="round"
						stroke-linejoin="round"
						aria-hidden="true"
