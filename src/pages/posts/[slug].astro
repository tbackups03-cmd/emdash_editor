---
import {
	getEmDashEntry,
	getEmDashCollection,
	getTermsForEntries,
	getSeoMeta,
	decodeSlug,
	getSiteSettings,
	getMenuWithCacheHint,
	getTaxonomyTermsWithCacheHint,
} from "emdash";
import { Image, PortableText, WidgetArea } from "emdash/ui";
import { Comments, CommentForm } from "emdash/ui/comments";
import Base from "../../layouts/Base.astro";
import Byline from "../../components/Byline.astro";
import PostCard from "../../components/PostCard.astro";
import { formatDate } from "../../utils/locale";
import { getReadingTime } from "../../utils/reading-time";
import { resolveBlogSiteIdentity } from "../../utils/site-identity";
import { checkPostAccess, type BookProduct } from "../../lib/member-access";
import { getDB } from "../../lib/member-auth";
import { fulfillCheckoutSessionById } from "../../lib/stripe";
import "../../styles/prose.css";

const slug = decodeSlug(Astro.params.slug);

if (!slug) {
	return Astro.rewrite("/404");
}

const { entry: post, cacheHint } = await getEmDashEntry("posts", slug);

if (!post) {
	return Astro.rewrite("/404");
}

if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

// Get featured image URL for OG fallback
// The image may have src (external) or meta.storageKey (local)
function getImageUrl(img: unknown): string | undefined {
	if (!img || typeof img !== "object") return undefined;
	const image = img as Record<string, unknown>;
	// Check for direct src
	if (typeof image.src === "string" && image.src) {
		return image.src.startsWith("http")
			? image.src
			: `${Astro.url.origin}${image.src}`;
	}
	// Build from storageKey for local images
	const meta = image.meta as Record<string, unknown> | undefined;
	const storageKey =
		(typeof meta?.storageKey === "string" ? meta.storageKey : undefined) ||
		(typeof image.id === "string" ? image.id : undefined);
	if (storageKey) {
		return `${Astro.url.origin}/_emdash/api/media/file/${storageKey}`;
	}
	return undefined;
}
const featuredImageUrl = getImageUrl(post.data.featured_image);
const { siteTitle } = resolveBlogSiteIdentity(await getSiteSettings());
const primaryMenuResult = await getMenuWithCacheHint("primary");
const navItems = primaryMenuResult.data?.items ?? [];

// 1. ดึงรายการโพสต์ล่าสุด 5 รายการสำหรับโซนเมนู
const { entries: menuRecentPosts } = await getEmDashCollection("posts", {
	orderBy: { published_at: "desc" },
	limit: 5,
});

// 2. ดึงหมวดหมู่ทั้งหมดพร้อมจำนวนบทความ
const categoriesResult = await getTaxonomyTermsWithCacheHint("category", {
	includeCounts: true,
});
const menuCategories = categoriesResult.data ?? [];

// 3. ดึงแท็กทั้งหมด
const tagsResult = await getTaxonomyTermsWithCacheHint("tag", {
	includeCounts: true,
});
const menuTags = tagsResult.data ?? [];

// 4. จัดกลุ่มเดือน/ปี สำหรับคลังเก็บถาวร
const { entries: allArchivePosts } = await getEmDashCollection("posts", {
	orderBy: { published_at: "desc" },
	limit: 500,
});
const archiveMap = new Map<string, { label: string; count: number }>();
for (const p of allArchivePosts) {
	const d = p.data.publishedAt;
	if (!d) continue;
	const key = `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, "0")}`;
	const label = d.toLocaleDateString("th-TH", { year: "numeric", month: "long" });
	const existing = archiveMap.get(key);
	if (existing) {
		existing.count += 1;
	} else {
		archiveMap.set(key, { label, count: 1 });
	}
}
const menuArchives = [...archiveMap.values()];

// Generate SEO meta from content
const seo = getSeoMeta(post, {
	siteTitle,
	siteUrl: Astro.url.origin,
	path: Astro.url.pathname.replace(/\/$/, ""),
	defaultOgImage: featuredImageUrl,
});

// Bylines are already hydrated by getEmDashEntry
const bylines = post.data.bylines ?? [];

// Get reading time
const readingTime = getReadingTime(post.data.content);

// This post's tags are already hydrated onto the entry by getEmDashEntry —
// no extra query needed.
const tags = post.data.terms?.tag ?? [];

// Fetch a few extra recent posts in case the current post is among them.
const { entries: recentPosts, cacheHint: recentPostsCacheHint } =
	await getEmDashCollection("posts", {
		orderBy: { published_at: "desc" },
		limit: 4,
	});
if (Astro.cache?.enabled) Astro.cache.set(recentPostsCacheHint);
const otherPosts = recentPosts.filter((p) => p.id !== post.id).slice(0, 3);

// Single batched query for related-posts tags, rather than one
// getEntryTerms() call per related post.
const otherTagsByEntry = await getTermsForEntries(
	"posts",
	otherPosts.map((p) => p.data.id),
	"tag",
);
const otherPostsWithTags = otherPosts.map((p) => ({
	post: p,
	tags: (otherTagsByEntry.get(p.data.id) ?? []).map((t) => ({
		slug: t.slug,
		label: t.label,
	})),
}));

const publishedAt = post.data.publishedAt ?? null;
const publishDate = publishedAt ? formatDate(publishedAt, "long") : null;

const checkoutStatus = Astro.url.searchParams.get("checkout");
const checkoutSessionId = Astro.url.searchParams.get("session_id") ?? "";
if (checkoutStatus === "success" && checkoutSessionId) {
	await fulfillCheckoutSessionById(checkoutSessionId);
}

// ตรวจสอบสิทธิ์การเข้าถึงบทความ (รองรับทั้งรายเดือน, ซื้อขาดรายเล่ม และแอดมินกำหนดเอง)
const categorySlugs = (post.data.terms?.category ?? []).map((c) => c.slug);
const isAdminLoggedIn = !!(Astro.locals as unknown as { user?: unknown }).user;
const accessResult = await checkPostAccess({
	cookies: Astro.cookies,
	categorySlugs,
	postSlug: slug,
	isAdminLoggedIn,
});

const monthlyPlan = await getDB()
	.prepare("SELECT price_thb FROM app_book_products WHERE category_slug = '__subscription__'")
	.first<Pick<BookProduct, "price_thb">>();

// --- ส่วนที่เพิ่มใหม่: เตรียมลิงก์ส่งต่อหน้าชำระเงินอัตโนมัติหลังล็อกอิน/สมัครสมาชิก ---
const autoCheckoutMode = Astro.url.searchParams.get("auto_checkout") ?? "";
const autoCheckoutTarget = Astro.url.searchParams.get("target_slug") ?? "";
const shouldAutoCheckout =
	Boolean(accessResult.member) &&
	!accessResult.hasAccess &&
	(autoCheckoutMode === "onetime" || autoCheckoutMode === "subscription");

const onetimeIntentUrl = `${Astro.url.pathname}?auto_checkout=onetime&target_slug=${encodeURIComponent(accessResult.product?.category_slug || "")}`;
const subscriptionIntentUrl = `${Astro.url.pathname}?auto_checkout=subscription&target_slug=${encodeURIComponent("*")}`;
// -----------------------------------------------------------------------------

// หากยังไม่มีสิทธิ์ ให้ส่งเนื้อหาไปตามจำนวนย่อหน้าตัวอย่างที่ตั้งค่าไว้ของหนังสือเล่มนี้
const previewCount = Math.max(0, accessResult.product?.preview_paragraphs ?? 2);
const visibleContent = accessResult.hasAccess
	? (post.data.content ?? [])
	: (post.data.content ?? []).slice(0, previewCount);

// ดึงรายชื่อหัวข้อ (h2, h3) ทั้งหมดของบทความเพื่อแสดงในสารบัญครบทุกบท (โดยไม่เปิดเผยเนื้อหาส่วนที่ล็อก)
interface TocHeadingItem {
	level: "h2" | "h3";
	text: string;
}

const fullTocHeadings: TocHeadingItem[] = (post.data.content ?? [])
	.filter(
		(block): block is Extract<typeof block, { _type: "block" }> =>
			block._type === "block" &&
			"style" in block &&
			(block.style === "h2" || block.style === "h3"),
	)
	.map((block) => {
		const children =
			"children" in block && Array.isArray(block.children) ? block.children : [];
		const text = children
			.map((child: unknown) =>
				child && typeof child === "object" && "text" in child
					? String((child as { text: unknown }).text ?? "")
					: "",
			)
			.join("")
			.trim();
		return {
			level: block.style as "h2" | "h3",
			text,
		};
	})
	.filter((item) => item.text.length > 0);

const hasHeadings = fullTocHeadings.length > 0;

// เปิดระบบป้องกันการคัดลอกเฉพาะบทความเสียเงินที่สมาชิกเปิดอ่าน (ยกเว้นแอดมินและบทความฟรี)
const enableCopyProtection =
	accessResult.isPaidContent && accessResult.hasAccess && !isAdminLoggedIn;
// --- ระบบนำทาง บทก่อนหน้า / บทถัดไป ภายในหนังสือ (หมวดหมู่) เดียวกัน ---
interface BookChapterItem {
	slug: string;
	title: string;
	publishedTime: number;
}

const rawCategories = post.data.terms?.category ?? [];
const primaryCategory = rawCategories[0] ?? null;
const matchedMenuCat = primaryCategory
	? menuCategories.find((c) => c.slug === primaryCategory.slug)
	: undefined;
const primaryCategoryName = primaryCategory
	? String(
			matchedMenuCat?.label ??
				(primaryCategory as { label?: string }).label ??
				primaryCategory.slug,
		)
	: "";

let prevChapter: BookChapterItem | null = null;
let nextChapter: BookChapterItem | null = null;
let currentChapterIndex = -1;
let totalChapters = 0;

if (primaryCategory && allArchivePosts.length > 0) {
	const archiveCategoriesByEntry = await getTermsForEntries(
		"posts",
		allArchivePosts.map((item) => item.data.id),
		"category",
	);

	const bookChapters: BookChapterItem[] = allArchivePosts
		.filter((item) => {
			const cats = archiveCategoriesByEntry.get(item.data.id) ?? [];
			return cats.some((c) => c.slug === primaryCategory.slug);
		})
		.map((item) => {
			const rawDate = item.data.publishedAt ? new Date(String(item.data.publishedAt)).getTime() : 0;
			return {
				slug: String(item.id),
				title: String(item.data.title ?? "ไม่มีชื่อบท"),
				publishedTime: Number.isNaN(rawDate) ? 0 : rawDate,
			};
		})
		.sort((a, b) => {
			if (a.publishedTime !== b.publishedTime) {
				return a.publishedTime - b.publishedTime;
			}
			return a.title.localeCompare(b.title, "th", { numeric: true });
		});

	totalChapters = bookChapters.length;
	currentChapterIndex = bookChapters.findIndex(
		(c) => c.slug === slug || c.slug === String(post.id),
	);

	if (currentChapterIndex > 0) {
		prevChapter = bookChapters[currentChapterIndex - 1] ?? null;
	}
	if (currentChapterIndex >= 0 && currentChapterIndex < bookChapters.length - 1) {
		nextChapter = bookChapters[currentChapterIndex + 1] ?? null;
	}
}
---


<Base
	title={seo.title}
	pageTitle={seo.ogTitle}
	description={seo.description}
	image={seo.ogImage}
	canonical={seo.canonical}
	robots={seo.robots}
	type="article"
	publishedTime={post.data.publishedAt?.toISOString() ?? null}
	modifiedTime={post.data.updatedAt.toISOString()}
	content={{ collection: "posts", id: post.data.id, slug }}
>
	<article class="post">
		<header class="intro post-header">
			<div class="frame">
				<div class="post-header__inner">
					<a href="/posts" class="arrow-link back-link">
						<svg
							viewBox="0 0 24 24"
							fill="none"
							stroke="currentColor"
							stroke-width="1.75"
							stroke-linecap="round"
							stroke-linejoin="round"
							aria-hidden="true"
						>
							<path d="M19 12H5"></path>
							<path d="m12 19-7-7 7-7"></path>
						</svg>
						บทความทั้งหมด
					</a>
					{
						tags.length > 0 && (
							<ul class="chips post-header__tags" aria-label="Tags">
								{tags.map((t) => (
									<li>
										<a href={`/tag/${t.slug}`} class="chip">
											{t.label}
										</a>
									</li>
								))}
							</ul>
						)
					}
					<h1 class="intro__title post-header__title" {...post.edit.title}>
						{post.data.title}
					</h1>
					{
						post.data.excerpt && (
							<p class="intro__lead post-header__lead" {...post.edit.excerpt}>
								{post.data.excerpt}
							</p>
						)
					}
					<div class="post-header__meta">
						<Byline bylines={bylines} layout="inline" max={2} size="md" />
						<p class="post-header__dateline">
							{
								publishedAt && (
									<time datetime={publishedAt.toISOString()}>
										{publishDate}
									</time>
								)
							}
							<span>ใช้เวลาอ่านประมาณ {readingTime} นาที</span>
						</p>
					</div>
				</div>
			</div>
		</header>

		{
			post.data.featured_image && (
				<div class="band post-hero">
					<div class="frame">
						<div class="post-hero__media" {...post.edit.featured_image}>
							<Image
								image={post.data.featured_image}
								sizes="(min-width: 1264px) 1136px, 92vw"
								priority
							/>
						</div>
					</div>
				</div>
			)
		}

		<div class="band section">
			<div class="frame post-layout">
				<div class="post-meta">
					<dl class="post-facts">
						{
							bylines.length > 0 && (
								<div class="post-fact">
									<dt class="eyebrow">
										{bylines.length === 1 ? "ผู้เขียน" : "ผู้เขียน"}
									</dt>
									<dd>
										<Byline bylines={bylines} layout="list" />
									</dd>
								</div>
							)
						}
						{
							publishedAt && (
								<div class="post-fact">
									<dt class="eyebrow">เผยแพร่เมื่อ</dt>
									<dd>
										<time datetime={publishedAt.toISOString()}>
											{publishDate}
										</time>
									</dd>
								</div>
							)
						}
						<div class="post-fact">
							<dt class="eyebrow">เวลาอ่าน</dt>
							<dd>{readingTime} นาที</dd>
						</div>
					</dl>
				</div>

				<div
					class={`post-main ${enableCopyProtection ? "post-main--protected" : ""}`}
					data-protected-article={enableCopyProtection ? "true" : undefined}
				>
					{
						checkoutStatus === "success" && (
							<div style="margin-bottom: 1.5rem; padding: 14px 18px; border-radius: 12px; background: rgb(22 163 74 / 0.14); border: 1px solid rgb(22 163 74 / 0.35); color: #16a34a; font-size: 0.95rem; font-weight: 500;">
								✓ ชำระเงินสำเร็จ! ระบบได้ปลดล็อกสิทธิ์การอ่านให้บัญชีของคุณเรียบร้อยแล้ว (หากเนื้อหายังไม่แสดงผลให้ลองรีเฟรชหน้าเว็บอีกครั้ง)
							</div>
						)
					}

					{
						enableCopyProtection && (
							<div class="print-block-notice" aria-hidden="true">
								เนื้อหานี้สงวนสิทธิ์เฉพาะสมาชิกที่ได้รับอนุญาต ไม่อนุญาตให้พิมพ์หรือทำซ้ำ
							</div>
						)
					}
					{
						visibleContent.length > 0 && (
							<div class="reader-toolbar" role="group" aria-label="ปรับขนาดตัวอักษร">
								<button
									type="button"
									class="reader-toolbar__btn"
									data-font-decrease
									aria-label="ลดขนาดตัวอักษร"
									title="ลดขนาดตัวอักษร"
								>
									ก-
								</button>
								<button
									type="button"
									class="reader-toolbar__value"
									data-font-reset
									aria-label="รีเซ็ตขนาดตัวอักษรเป็นค่าเริ่มต้น"
									title="กดเพื่อกลับเป็นขนาดปกติ (100%)"
								>
									100%
								</button>
								<button
									type="button"
									class="reader-toolbar__btn"
									data-font-increase
									aria-label="เพิ่มขนาดตัวอักษร"
									title="เพิ่มขนาดตัวอักษร"
								>
									ก+
								</button>
							</div>
						)
					}
					<div
						id="reading-resume-banner"
						class="reading-resume-banner"
						hidden
						data-book-slug={primaryCategory?.slug ?? ""}
						data-chapter-slug={slug}
						data-chapter-title={String(post.data.title ?? "")}
					>
						<div class="reading-resume-banner__info">
							<span class="reading-resume-banner__badge">อ่านต่อจากเดิม</span>
							<span class="reading-resume-banner__text" data-resume-text></span>
						</div>
						<div class="reading-resume-banner__actions">
							<button type="button" class="btn btn--sm" data-resume-jump>
								เลื่อนไปจุดที่อ่านค้างไว้
							</button>
							<button
								type="button"
								class="reading-resume-banner__close"
								data-resume-dismiss
								aria-label="ปิดแถบแจ้งเตือน"
							>
								✕
							</button>
						</div>
					</div>
					<div class="protected-reading-wrap">
						{
							visibleContent.length > 0 && (
								<div
									class={`prose ${!accessResult.hasAccess ? "prose--locked-preview" : ""}`}
									data-post-content
								>
									<PortableText value={visibleContent} />
								</div>
							)
						}
					</div>

					{
						!accessResult.hasAccess && (
							<div
								id="paywall-box"
								class="paywall-box"
								role="region"
								aria-label="เนื้อหาสำหรับสมาชิก"
								data-auto-checkout={shouldAutoCheckout ? autoCheckoutMode : ""}
								data-auto-target={shouldAutoCheckout ? autoCheckoutTarget : ""}
							>
								<div class="paywall-box__badge">เนื้อหาเฉพาะสมาชิก / ผู้สั่งซื้อ</div>
								<h2 class="paywall-box__title">
									อ่านต่อฉบับเต็มในหนังสือ “{accessResult.product?.title || post.data.title}”
								</h2>
								<p class="paywall-box__desc">
									{accessResult.member
										? `สวัสดีคุณ ${accessResult.member.display_name} บัญชีของคุณยังไม่มีสิทธิ์เข้าถึงหนังสือเล่มนี้ เลือกรูปแบบการเข้าถึงที่ต้องการด้านล่าง:`
										: "เนื้อหาส่วนถัดไปสงวนสิทธิ์สำหรับผู้ที่สั่งซื้อหนังสือเล่มนี้ หรือสมาชิกรายเดือน กรุณาเข้าสู่ระบบหรือเลือกรูปแบบการเข้าถึง:"}
								</p>

								<div class="paywall-plans">
									<!-- ตัวเลือกที่ 1: ซื้อขาดรายเล่ม -->
									<div class="paywall-plan">
										<div class="paywall-plan__head">
											<span class="paywall-plan__tag">รูปแบบที่ 1 • ซื้อขาดรายเล่ม</span>
											<h3 class="paywall-plan__name">
												{accessResult.product?.title || "หนังสือเล่มนี้"}
											</h3>
											<p class="paywall-plan__price">
												{accessResult.product && accessResult.product.price_thb > 0
													? `${accessResult.product.price_thb.toLocaleString()} บาท`
													: "เหมาจ่ายครั้งเดียว"}
												<span> / อ่านได้ตลอดชีพ</span>
											</p>
										</div>
										<ul class="paywall-plan__features">
											<li>เข้าถึงทุกบทเรียนในหมวดหนังสือนี้</li>
											<li>กลับมาอ่านซ้ำได้ตลอด 24 ชม. ไม่มีวันหมดอายุ</li>
										</ul>
										{accessResult.member ? (
											<button
												type="button"
												class="btn paywall-plan__btn"
												data-checkout-btn
												data-checkout-mode="onetime"
												data-target-slug={accessResult.product?.category_slug || ""}
											>
												ซื้อขาดหนังสือเล่มนี้
											</button>
										) : (
											<a
												href={`/login?redirect=${encodeURIComponent(onetimeIntentUrl)}`}
												class="btn paywall-plan__btn"
											>
												เข้าสู่ระบบ / สมัครเพื่อซื้อเล่มนี้
											</a>
										)}
									</div>

									<!-- ตัวเลือกที่ 2: สมาชิกรายเดือน -->
									<div class="paywall-plan paywall-plan--vip">
										<div class="paywall-plan__head">
											<span class="paywall-plan__tag">รูปแบบที่ 2 • สมาชิกเต็มรูปแบบ</span>
											<h3 class="paywall-plan__name">อ่านได้ทุกเล่มไม่จำกัด</h3>
											<p class="paywall-plan__price">
												{monthlyPlan && monthlyPlan.price_thb > 0
													? `${monthlyPlan.price_thb.toLocaleString()} บาท`
													: "สมาชิกรายเดือน"}
												<span> / เดือน (อ่านได้ทุกเล่ม)</span>
											</p>
										</div>
										<ul class="paywall-plan__features">
											<li>ปลดล็อกหนังสือและบทความพิเศษทั้งหมด</li>
											<li>อัปเดตบทเรียนใหม่เข้าถึงได้ทันทีโดยไม่จำกัด</li>
										</ul>
										{accessResult.member ? (
											<button
												type="button"
												class="btn paywall-plan__btn"
												data-checkout-btn
												data-checkout-mode="subscription"
												data-target-slug="*"
											>
												สมัครสมาชิกรายเดือน
											</button>
										) : (
											<a
												href={`/register?redirect=${encodeURIComponent(subscriptionIntentUrl)}`}
												class="btn btn--ghost paywall-plan__btn"
											>
												สมัครสมาชิกรายเดือน
											</a>
										)}
									</div>
								</div>

								{!accessResult.member && (
									<p class="paywall-box__footer">
										มีบัญชีสมาชิกอยู่แล้ว?{" "}
										<a href={`/login?redirect=${encodeURIComponent(Astro.url.pathname)}`}>
											เข้าสู่ระบบที่นี่
										</a>
									</p>
								)}
							</div>
						)
					}
					{
						primaryCategory && totalChapters > 1 && currentChapterIndex >= 0 && (
							<nav class="chapter-nav" aria-label="นำทางบทเรียนในหนังสือ">
								<div class="chapter-nav__header">
									<span class="chapter-nav__book">
										หนังสือ: <strong>{primaryCategoryName}</strong>
									</span>
									<span class="chapter-nav__progress">
										บทที่ {currentChapterIndex + 1} จาก {totalChapters} บท
									</span>
								</div>

								<div class="chapter-nav__grid">
									{prevChapter ? (
										<a href={`/posts/${prevChapter.slug}`} class="chapter-nav__card chapter-nav__card--prev">
											<span class="chapter-nav__dir">← บทก่อนหน้า</span>
											<span class="chapter-nav__title">{prevChapter.title}</span>
										</a>
									) : (
										<div class="chapter-nav__card chapter-nav__card--empty" aria-disabled="true">
											<span class="chapter-nav__dir">← บทก่อนหน้า</span>
											<span class="chapter-nav__title">คุณกำลังอ่านบทแรกของเล่มนี้</span>
										</div>
									)}

									{nextChapter ? (
										<a href={`/posts/${nextChapter.slug}`} class="chapter-nav__card chapter-nav__card--next">
											<span class="chapter-nav__dir">บทถัดไป →</span>
											<span class="chapter-nav__title">{nextChapter.title}</span>
										</a>
									) : (
										<div class="chapter-nav__card chapter-nav__card--empty" aria-disabled="true">
											<span class="chapter-nav__dir">บทถัดไป →</span>
											<span class="chapter-nav__title">จบบทล่าสุดของเล่มนี้แล้ว</span>
										</div>
									)}
								</div>
							</nav>
						)
					}
					{
						accessResult.hasAccess && (
							<section class="post-comments" aria-labelledby="comments-title">
								<h2 id="comments-title" class="eyebrow">ความคิดเห็น</h2>
								<Comments collection="posts" contentId={post.data.id} threaded />
								<CommentForm collection="posts" contentId={post.data.id} />
							</section>
						)
					}
				</div>

				<div class="post-rail">
					<nav
						class="toc"
						aria-labelledby="toc-title"
						hidden={!hasHeadings}
						data-toc
						data-full-toc={JSON.stringify(fullTocHeadings)}
					>
						<h2 id="toc-title" class="eyebrow">ในหน้านี้</h2>
						<ol class="toc__list" data-toc-list></ol>
					</nav>

					<aside class="post-widgets" aria-labelledby="widgets-title">
						<h2 id="widgets-title" class="sr-only">More from the blog</h2>
						<WidgetArea name="sidebar" />
					</aside>
				</div>
			</div>
		</div>
	</article>
	<!-- ปุ่มเปิดสารบัญ (3 ขีด) และแถบสารบัญด้านซ้ายสำหรับมือถือ -->
	<div class="mobile-toc" hidden={!hasHeadings} data-mobile-toc>
		<button
			type="button"
			class="mobile-toc__toggle"
			aria-label="เปิดสารบัญ"
