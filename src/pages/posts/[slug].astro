				<line x1="3" y1="18" x2="21" y2="18"></line>
			</svg>
			<span>สารบัญ</span>
		</button>

		<div class="mobile-toc__backdrop" data-mobile-toc-backdrop></div>

		<aside
			id="mobile-toc-drawer"
			class="mobile-toc__drawer"
			aria-labelledby="mobile-toc-title"
			aria-hidden="true"
			data-mobile-toc-drawer
