---
import Base from "../layouts/Base.astro";
import { getCurrentMember, sanitizeRedirectPath } from "../lib/member-auth";

const currentMember = await getCurrentMember(Astro.cookies);
const redirectTo = sanitizeRedirectPath(Astro.url.searchParams.get("redirect"), "/");

if (currentMember) {
	return Astro.redirect(redirectTo);
}
---

<Base title="เข้าสู่ระบบ" description="เข้าสู่ระบบสมาชิกเพื่ออ่านหนังสือและบทความของคุณ">
	<section class="band section">
		<div class="frame">
			<div class="auth-card">
				<p class="eyebrow">สมาชิกผู้อ่าน</p>
				<h1 class="auth-card__title">เข้าสู่ระบบ</h1>
				<p class="auth-card__desc">
					กรอกอีเมลและรหัสผ่านเพื่อเข้าถึงหนังสือและบทเรียนของคุณ
				</p>

				<form id="login-form" class="auth-form" data-redirect={redirectTo}>
					<div class="auth-field">
						<label for="email">อีเมล</label>
						<input
							id="email"
							name="email"
							type="email"
							required
							placeholder="name@example.com"
						/>
					</div>

					<div class="auth-field">
						<div style="display: flex; justify-content: space-between; align-items: center; gap: 8px;">
							<label for="password">รหัสผ่าน</label>
							<a href="/forgot-password" style="font-size: var(--font-size-xs); color: var(--color-brand);">
								ลืมรหัสผ่าน?
							</a>
						</div>
						<input
							id="password"
							name="password"
							type="password"
							required
							placeholder="••••••••"
						/>
					</div>

					<p id="auth-error" class="auth-error" hidden></p>

					<button type="submit" id="submit-btn" class="btn auth-submit">
						เข้าสู่ระบบ
					</button>
				</form>

				<p class="auth-switch">
					ยังไม่มีบัญชีสมาชิก?{" "}
					<a href={`/register${redirectTo !== "/" ? `?redirect=${encodeURIComponent(redirectTo)}` : ""}`}>
						สมัครสมาชิกฟรี
					</a>
				</p>
			</div>
		</div>
	</section>
</Base>

<script>
	const form = document.getElementById("login-form") as HTMLFormElement | null;
	const errorEl = document.getElementById("auth-error");
	const submitBtn = document.getElementById("submit-btn") as HTMLButtonElement | null;

	form?.addEventListener("submit", async (e) => {
		e.preventDefault();
		if (!form || !errorEl || !submitBtn) return;

		errorEl.hidden = true;
		submitBtn.disabled = true;
		submitBtn.textContent = "กำลังเข้าสู่ระบบ...";

		const formData = new FormData(form);
		const payload = {
			email: formData.get("email"),
			password: formData.get("password"),
		};

		try {
			const res = await fetch("/api/member/login", {
				method: "POST",
				headers: { "Content-Type": "application/json" },
				body: JSON.stringify(payload),
			});
			const data = await res.json();

			if (!res.ok) {
				errorEl.textContent = data.error || "เข้าสู่ระบบไม่สำเร็จ";
				errorEl.hidden = false;
				submitBtn.disabled = false;
				submitBtn.textContent = "เข้าสู่ระบบ";
				return;
			}

			window.location.href = form.dataset.redirect || "/";
		} catch {
			errorEl.textContent = "ไม่สามารถเชื่อมต่อเซิร์ฟเวอร์ได้ กรุณาลองใหม่";
			errorEl.hidden = false;
			submitBtn.disabled = false;
			submitBtn.textContent = "เข้าสู่ระบบ";
		}
	});
</script>

<style>
	.auth-card {
		width: 100%;
		max-width: 440px;
		min-width: 0;
		box-sizing: border-box;
		margin-inline: auto;
		padding: clamp(1.25rem, 4vw, 2.25rem);
		border: 1px solid var(--color-border);
		border-radius: 18px;
		background: var(--color-surface);
		box-shadow: var(--shadow-md);
	}

	.auth-card__title {
		margin-top: var(--spacing-2);
		font-size: var(--font-size-2xl);
		line-height: 1.3;
		overflow-wrap: break-word;
	}

	.auth-card__desc {
		margin-top: var(--spacing-2);
		font-size: var(--font-size-sm);
		color: var(--color-text-secondary);
		overflow-wrap: break-word;
	}

	.auth-form {
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		gap: var(--spacing-4);
		margin-top: var(--spacing-6);
		min-width: 0;
	}

	.auth-field {
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		gap: 6px;
		min-width: 0;
	}

	.auth-field label {
		font-size: var(--font-size-sm);
		font-weight: 500;
		color: var(--color-text);
	}

	.auth-field input {
		width: 100%;
		max-width: 100%;
		min-width: 0;
		box-sizing: border-box;
		height: 2.75rem;
		padding-inline: var(--spacing-4);
		border: 1px solid var(--color-border);
		border-radius: var(--radius);
		background: var(--color-bg);
		color: var(--color-text);
		font: inherit;
		font-size: var(--font-size-sm);
	}

	.auth-field input:focus {
		outline: 2px solid transparent;
		border-color: var(--color-brand);
		box-shadow: 0 0 0 3px var(--color-brand-ring);
	}

	.auth-error {
		box-sizing: border-box;
		padding: 10px 14px;
		border-radius: var(--radius);
		background: rgb(220 38 38 / 0.12);
		border: 1px solid rgb(220 38 38 / 0.35);
		color: #ef4444;
		font-size: var(--font-size-sm);
		overflow-wrap: break-word;
	}

	.auth-submit {
		width: 100%;
		min-height: 2.75rem;
		margin-top: var(--spacing-1);
	}

	.auth-submit:disabled {
		opacity: 0.65;
		cursor: not-allowed;
	}

	.auth-switch {
		margin-top: var(--spacing-5);
		text-align: center;
		font-size: var(--font-size-sm);
		color: var(--color-text-secondary);
		overflow-wrap: break-word;
	}
</style>