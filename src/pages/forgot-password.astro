---
import Base from "../layouts/Base.astro";
---

<Base title="ลืมรหัสผ่าน" description="ขอลิงก์ตั้งรหัสผ่านใหม่ทางอีเมล">
	<section class="band section">
		<div class="frame">
			<div class="auth-card">
				<p class="eyebrow">กู้คืนบัญชีสมาชิก</p>
				<h1 class="auth-card__title">ลืมรหัสผ่านใช่ไหม?</h1>
				<p class="auth-card__desc">
					กรอกอีเมลที่ใช้สมัครสมาชิก ระบบจะส่งลิงก์สำหรับตั้งรหัสผ่านใหม่ไปให้ทางอีเมล
				</p>

				<form id="forgot-form" class="auth-form">
					<div class="auth-field">
						<label for="email">อีเมลสมาชิก</label>
						<input
							id="email"
							name="email"
							type="email"
							required
							placeholder="name@example.com"
						/>
					</div>

					<p id="auth-error" class="auth-error" hidden></p>
					<p id="auth-success" class="auth-success" hidden></p>

					<button type="submit" id="submit-btn" class="btn auth-submit">
						ส่งลิงก์ตั้งรหัสผ่านใหม่
					</button>
				</form>

				<p class="auth-switch">
					จำรหัสผ่านได้แล้ว? <a href="/login">กลับไปหน้าเข้าสู่ระบบ</a>
				</p>
			</div>
		</div>
	</section>
</Base>

<script>
	const form = document.getElementById("forgot-form") as HTMLFormElement | null;
	const errorEl = document.getElementById("auth-error");
	const successEl = document.getElementById("auth-success");
	const submitBtn = document.getElementById("submit-btn") as HTMLButtonElement | null;

	form?.addEventListener("submit", async (e) => {
		e.preventDefault();
		if (!form || !errorEl || !successEl || !submitBtn) return;

		errorEl.hidden = true;
		successEl.hidden = true;
		submitBtn.disabled = true;
		submitBtn.textContent = "กำลังส่งอีเมล...";

		const formData = new FormData(form);

		try {
			const res = await fetch("/api/member/forgot-password", {
				method: "POST",
				headers: { "Content-Type": "application/json" },
				body: JSON.stringify({ email: formData.get("email") }),
			});
			const data = await res.json();

			if (!res.ok) {
				errorEl.textContent = data.error || "ไม่สามารถส่งคำขอได้";
				errorEl.hidden = false;
				submitBtn.disabled = false;
				submitBtn.textContent = "ส่งลิงก์ตั้งรหัสผ่านใหม่";
				return;
			}

			successEl.textContent =
				"หากอีเมลนี้ลงทะเบียนอยู่ในระบบ เราได้ส่งลิงก์ตั้งรหัสผ่านใหม่ไปให้แล้ว กรุณาตรวจสอบกล่องจดหมาย (รวมถึงโฟลเดอร์จดหมายขยะ)";
			successEl.hidden = false;
			form.reset();
			submitBtn.textContent = "ส่งลิงก์เรียบร้อยแล้ว";
		} catch {
			errorEl.textContent = "ไม่สามารถเชื่อมต่อเซิร์ฟเวอร์ได้ กรุณาลองใหม่";
			errorEl.hidden = false;
			submitBtn.disabled = false;
			submitBtn.textContent = "ส่งลิงก์ตั้งรหัสผ่านใหม่";
		}
	});
</script>

<style>
	.auth-card {
		width: 100%;
		max-width: 440px;
		min-width: 0;
		box-sizing: border-box;
		margin-inline: auto;
		padding: clamp(1.25rem, 4vw, 2.25rem);
		border: 1px solid var(--color-border);
		border-radius: 18px;
		background: var(--color-surface);
		box-shadow: var(--shadow-md);
	}

	.auth-card__title {
		margin-top: var(--spacing-2);
		font-size: var(--font-size-2xl);
		line-height: 1.3;
	}

	.auth-card__desc {
		margin-top: var(--spacing-2);
		font-size: var(--font-size-sm);
		color: var(--color-text-secondary);
	}

	.auth-form {
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		gap: var(--spacing-4);
		margin-top: var(--spacing-6);
	}

	.auth-field {
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		gap: 6px;
	}

	.auth-field label {
		font-size: var(--font-size-sm);
		font-weight: 500;
		color: var(--color-text);
	}

	.auth-field input {
		width: 100%;
		max-width: 100%;
		min-width: 0;
		box-sizing: border-box;
		height: 2.75rem;
		padding-inline: var(--spacing-4);
		border: 1px solid var(--color-border);
		border-radius: var(--radius);
		background: var(--color-bg);
		color: var(--color-text);
		font: inherit;
		font-size: var(--font-size-sm);
	}

	.auth-field input:focus {
		outline: 2px solid transparent;
		border-color: var(--color-brand);
		box-shadow: 0 0 0 3px var(--color-brand-ring);
	}

	.auth-error {
		padding: 10px 14px;
		border-radius: var(--radius);
		background: rgb(220 38 38 / 0.12);
		border: 1px solid rgb(220 38 38 / 0.35);
		color: #ef4444;
		font-size: var(--font-size-sm);
	}

	.auth-success {
		padding: 10px 14px;
		border-radius: var(--radius);
		background: rgb(22 163 74 / 0.12);
		border: 1px solid rgb(22 163 74 / 0.35);
		color: #16a34a;
		font-size: var(--font-size-sm);
	}

	.auth-submit {
		width: 100%;
		min-height: 2.75rem;
		margin-top: var(--spacing-1);
	}

	.auth-submit:disabled {
		opacity: 0.65;
		cursor: not-allowed;
	}

	.auth-switch {
		margin-top: var(--spacing-5);
		text-align: center;
		font-size: var(--font-size-sm);
		color: var(--color-text-secondary);
	}
</style>